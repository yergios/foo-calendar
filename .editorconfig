#### Project overrides ####
# Everything below departs from the template above, and says why. In .editorconfig the last
# matching value wins, so these replace the template's values without editing them.

[*]
# The repository stores LF (.gitattributes) on every platform.
end_of_line = lf
# The template asks for no final newline in C# files; git and POSIX tools expect one.
insert_final_newline = true

[*.{ts,mts,js,mjs,vue,css,html,yml,yaml,md}]
# Prettier's tabWidth for the SPA (src/Web/.prettierrc); YAML and Markdown follow suit.
indent_size = 2

[*.cs]
# This codebase uses var throughout. The template's preference is the opposite, which would
# point every IDE refactoring the wrong way.
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = true:silent

# Private fields are plain camelCase (no leading underscore), and primary-constructor
# parameters already read that way, so the template's _camelCase rule is restyled to match.
dotnet_naming_rule.private_fields_should_be__camelcase.style = camelcase

# Template bug: it scopes the "type parameters start with T" rule to namespaces.
dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

# Enforced in the build (EnforceCodeStyleInBuild; warnings fail it). The template ships
# these as IDE suggestions; here they are conventions every file already follows.
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_primary_constructors = true:warning

# Raised to warnings in the IDE only. The command-line build ignores a naming rule's own
# severity and reports IDE1006 only when dotnet_diagnostic.IDE1006.severity is set, which
# would enforce every naming rule above, the template's s_ prefix for static fields
# included. In the build these two conventions are enforced by CA1715 (I and T prefixes)
# and S101 (PascalCase types) instead.
dotnet_naming_rule.interfaces_should_be_ipascalcase.severity = warning
dotnet_naming_rule.types_and_namespaces_should_be_pascalcase.severity = warning

# Analyzer rules turned off on purpose. Directory.Build.props enables every rule
# (AnalysisMode=All) and treats warnings as errors, so each entry here is a decision with
# its reason, not a warning nobody got to. Prefer fixing the code, or a scoped #pragma with
# a reason at the one site, over adding a line here.

# CA1002: Do not expose generic lists. Guards a library's public surface; the public types
# here are DTOs, options and services that nobody outside this solution compiles against.
dotnet_diagnostic.CA1002.severity = none

# CA1062: Validate public arguments for null. Same reasoning: there are no callers outside
# the solution. Arguments come from model binding, DI or this solution's own code, all of it
# compiled with nullable reference types on (Directory.Build.props), so the compiler already
# refuses a null where a parameter says there is none. The rule ignores those annotations and
# would ask for a runtime guard per method on top.
dotnet_diagnostic.CA1062.severity = none

# CA1515: Make public types internal. They are public so the test project can use them;
# InternalsVisibleTo would trade one annotation for another and buy nothing.
dotnet_diagnostic.CA1515.severity = none

# CA1716: Identifier conflicts with a keyword. Only fires for VB keywords (from, to, step),
# and nothing consumes this assembly from VB.
dotnet_diagnostic.CA1716.severity = none

# CA1724: Type name matches a framework namespace. Api.Configuration.Permissions is worth
# the collision with System.Security.Permissions, which nothing here imports.
dotnet_diagnostic.CA1724.severity = none

# CA1054/CA1056: URI parameters and properties should be System.Uri. Most are config values
# handed to the browser untouched, where Team:SupportUrl may be mailto: and
# Auth:RedirectUri is relative by default. The one the server uses, Holidays:Nager:BaseUrl,
# is bound from configuration as text and parsed once where its HttpClient is registered.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none

# CA1812: Internal class is never instantiated. Fires on the private records that
# System.Text.Json deserializes into, which it creates by reflection the analyzer can't see.
dotnet_diagnostic.CA1812.severity = none

# CA1848/CA1873: Use LoggerMessage delegates / avoid expensive logging arguments. Every
# log call here is off the request hot path (startup, syncs, sweeps, failures), where
# source-generated logging would add ceremony without a measurable gain.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# CA2007: ConfigureAwait. ASP.NET Core has no synchronization context to capture.
dotnet_diagnostic.CA2007.severity = none

[**/Migrations/**.cs]
# Generated by dotnet-ef from the model: analysis would only flag code nobody edits by hand.
generated_code = true

[tests/**.cs]
# CA1707: Remove underscores from member names. Test names follow
# Method_WhenCondition_ExpectedOutcome, where the underscores are the separators.
dotnet_diagnostic.CA1707.severity = none

# CA1034: Nested types should not be visible. Test doubles keep their recorded-call type
# nested beside them, and nothing outside the test assembly sees either.
dotnet_diagnostic.CA1034.severity = none

# CA1849/S6966: Call async methods when in an async method. Arrange steps seed a per-test
# in-memory SQLite database synchronously, which blocks on nothing and keeps the seeding
# helpers callable from constructors.
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.S6966.severity = none

# CA2000: Dispose objects before losing scope. Stub HttpClients handed to a system under
# test live exactly as long as that one test and hold no OS resources (the handler never
# opens a socket), so ownership plumbing would add noise for nothing.
dotnet_diagnostic.CA2000.severity = none
