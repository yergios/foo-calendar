{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git log --oneline -20)",
      "Bash(git diff --no-ext-diff --no-textconv)",
      "Bash(git diff --no-ext-diff --no-textconv --stat)",
      "Bash(git diff --cached --no-ext-diff --no-textconv)",
      "Bash(git diff --cached --no-ext-diff --no-textconv --stat)",
      "Bash(dotnet build)",
      "Bash(dotnet build --configuration Release)",
      "Bash(dotnet build --no-restore --configuration Release)",
      "Bash(dotnet test)",
      "Bash(dotnet test --configuration Release)",
      "Bash(dotnet test --no-build --configuration Release)",
      "Bash(dotnet ef migrations has-pending-model-changes --project src/Api)",
      "Bash(pnpm --dir src/Web typecheck)",
      "Bash(pnpm --dir src/Web lint:check)",
      "Bash(pnpm --dir src/Web format:check)",
      "Bash(pnpm --dir src/Web test)",
      "Bash(node scripts/check-spec-trace.mjs)",
      "Bash(node scripts/privacy-review.mjs hash)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh --list)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.mjs\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/commit-privacy.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
