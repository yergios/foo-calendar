{
  "ConnectionStrings": {
    "FooCalendarDb": "Data Source=foo-calendar.db"
  },
  "Team": {
    "OrgName": "",
    "HomeRegion": "CH-ZH",
    "HomeTimeZone": "Europe/Zurich",
    "SupportUrl": "mailto:support@example.com",
    "IssueUrl": "https://github.com/your-org/foo-calendar/issues"
  },
  "Retention": {
    "AuditEntryDays": 365,
    "AbsenceDays": 0
  },
  "Holidays": {
    "Source": "Nager",
    "SyncInterval": "7.00:00:00",
    "Nager": {
      "BaseUrl": "https://date.nager.at/api/v3/"
    },
    "File": {
      "Path": ""
    }
  },
  "Auth": {
    "Provider": "Oidc",
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "Scope": "openid profile email offline_access",
    "RedirectUri": "/callback",
    "PostLogoutRedirectUri": "/",
    "Permissions": {
      "PeopleManage": [ "PeopleManage" ],
      "ReportsRead": [ "ReportsRead" ],
      "HolidaysSync": [ "HolidaysSync" ],
      "AuditRead": [ "AuditRead" ]
    },
    "ClaimTypes": {
      "Permissions": [ "permissions" ]
    }
  },
  "ApiDocs": {
    "Enabled": false,
    "RoutePrefix": "/scalar"
  },
  "ReverseProxy": {
    "PathBase": "",
    "TrustForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Telemetry": {
    "OtlpEndpoint": "",
    "OtlpProtocol": "",
    "ServiceName": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
