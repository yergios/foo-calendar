# Used for both TEST and STAGE env
VITE_BASE_URL=

# Nothing environment-specific belongs in this file. OIDC settings, the team's name,
# support links and the admin permission are served by the API at runtime, so this build
# is deployment-agnostic: configure it in the API's appsettings.json or via environment
# variables (Team__OrgName, Auth__Authority, ...). Colors and fonts are the exception -
# they are compiled in, see src/styles/theme.css.
