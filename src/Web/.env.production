# Used for both TEST and STAGE env
VITE_BASE_URL=

# Nothing environment-specific belongs in this file. Branding, OIDC settings and the
# admin permission are served by the API at runtime (GET /api/config/bootstrap), so this
# build is deployment-agnostic: configure it in the API's appsettings.json or via
# environment variables (Branding__AppName, Auth__Authority, ...).
