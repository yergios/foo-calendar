VITE_BASE_URL=http://localhost:5173
VITE_API_TARGET_URL=http://localhost:5055
VITE_MOCK=false

# OIDC settings, the team's name, support links and the admin permission are NOT here:
# the API serves them at runtime from appsettings.json, so the same frontend build works
# for every deployment. Point the API at a different IdP without rebuilding anything here.
# Colors and fonts are the exception - they are compiled in, see src/styles/theme.css.
#
# For local development that means Auth:Provider=None in appsettings.Development.json is
# what bypasses SSO, and Auth:DevUser:Permissions is what grants the admin UI.
