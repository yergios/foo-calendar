VITE_BASE_URL=http://localhost:5173
VITE_API_TARGET_URL=http://localhost:5055
VITE_MOCK=false

# Branding, OIDC settings and the admin permission are NOT here: the API serves them at
# runtime from appsettings.json (see GET /api/config/bootstrap), so the same frontend
# build works for every deployment. Point the API at a different IdP, or rename the app,
# without rebuilding anything here.
#
# For local development that means Auth:Provider=None in appsettings.Development.json is
# what bypasses SSO, and Auth:DevUser:Permissions is what grants the admin UI.
