VITE_BASE_URL=http://localhost:5173
VITE_API_TARGET_URL=http://localhost:5055
VITE_MOCK=false

# Customize this to your own branding.
VITE_APP_NAME=Foo Calendar

VITE_SUPPORT_URL=mailto:support@example.com
VITE_ISSUE_URL=https://github.com/your-org/foo-calendar/issues

VITE_OIDC_AUTHORITY=https://your-oidc-provider.example.com
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE=https://foo-calendar.example.com/api
VITE_OIDC_SCOPE="openid profile email offline_access"
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback

VITE_ADMIN_PERMISSION=APP_FOO_CALENDAR_ADMIN
# Dev-only convenience: skip the admin permission check regardless of the signed-in
# user's actual token, so admin UI can be reached without an admin-permissioned account.
# Only ever set here, never in .env.production, so it can't leak into a deployment.
VITE_BYPASS_ADMIN_PERMISSION=true

# No real OIDC tenant needed: skips SSO entirely and pretends to already be logged in
# as a fixed dev user (matches the API's Auth:DevUser in appsettings.Development.json).
# Only ever set here, never in .env.production, so it can't leak into a deployment.
VITE_AUTH_MODE=dev

