# Copy to .env and fill in, then `docker compose up -d`.
#
# These are plain .NET configuration keys: every setting in src/Api/appsettings.json can
# be overridden here, using __ for nesting. Nothing here is compiled into the frontend,
# so changing any of it takes effect on restart, not on rebuild.

# ---- Your team ----
# The app's own name and mark are fixed and are not configuration (see TRADEMARK.md).
# What you set here is who the deployment belongs to and where its users get help.
Team__OrgName=Acme Engineering
Team__SupportUrl=mailto:support@example.com
Team__IssueUrl=https://github.com/your-org/foo-calendar/issues

# ---- Retention ----
# How long data is kept, in days; 0 keeps it forever. There is no "GDPR number" for these:
# the rule is "no longer than necessary for the purpose", and the purpose is yours to
# state. See docs/data-protection.md.
Retention__AuditEntryDays=365
Retention__NotificationDays=90
# Off by default: looking back over previous years is what a leave calendar is for.
Retention__AbsenceDays=0

# ---- Authentication ----
# From your OIDC provider (Auth0, Okta, Keycloak, Azure AD, ...). The app refuses to
# start without these, rather than failing later when someone tries to sign in.
Auth__Authority=
Auth__Audience=
Auth__ClientId=

# Or: no identity provider at all. Both lines are required, and the second one is how you
# confirm you mean it. Anyone who can reach the app is then anyone they choose to be, so
# this belongs only on a network where reaching the app is already the access control.
# See "Running without an identity provider" in the README.
# Auth__Provider=None
# Auth__AllowUnauthenticatedDeployment=true

# Which claim values grant each permission, and which claims to look for them in. Both
# are lists: holding any one value is enough, and every listed claim is searched. Entra
# ID, for one, puts app roles in "roles" and group ids in "groups".
#
# Signing in is already enough to keep your own profile and absences and to maintain the
# team's manually added bank holidays. These four are the rest, and every one of them must
# name at least one value or the app refuses to start.
#
# A value apiece, as below, is what lets you hand the holiday sync to the office
# coordinator without handing over the people list too. Naming the same value under all
# four instead is one undivided admin role, which is a perfectly good place to start.
Auth__Permissions__PeopleManage__0=PeopleManage
Auth__Permissions__ReportsRead__0=ReportsRead
Auth__Permissions__HolidaysSync__0=HolidaysSync
Auth__Permissions__AuditRead__0=AuditRead
# A permission can accept more than one value, so a group id and a friendlier role name
# can coexist while you migrate between them.
#Auth__Permissions__HolidaysSync__1=8f4c2f1a-0000-4c1e-9a3e-1c2d3e4f5a6b
#Auth__ClaimTypes__Permissions__0=roles
#Auth__ClaimTypes__Permissions__1=groups

# AbsencesApprove is the exception to "every permission must name a value": it only
# matters when AbsenceApprovals__Enabled is turned on below, so it's fine to leave
# unconfigured otherwise.
#Auth__Permissions__AbsencesApprove__0=AbsencesApprove

# ---- Team ----
# Required. ISO 3166-2 (a bare country code is fine). The team's own locality: its holidays
# are synced whether or not anyone picked it, and are never removed. Every other region the
# calendar tracks is derived from where people say they are.
Team__HomeRegion=CH-ZH

# Required. An IANA timezone id. Every time-based absence's start/end time is wall-clock
# time in this one zone, for every viewer, with no per-viewer conversion - the team has one
# timezone for these, not one per person.
Team__HomeTimeZone=Europe/Zurich

# ---- Holidays ----
# "Nager" (default, needs outbound internet), "File", or "None". A file source is the
# way in for networks with no egress, and for company closures no public API knows about.
#Holidays__Source=File
#Holidays__File__Path=/etc/foo-calendar/holidays.json
#Holidays__SyncInterval=7.00:00:00

# ---- Absence approvals ----
# Off by default: every absence is approved the moment it's created, as always. Turn this
# on to require someone holding AbsencesApprove (see above) to approve or reject each one
# first.
#AbsenceApprovals__Enabled=true

# ---- Behind a reverse proxy ----
# Only needed when something else terminates TLS or routes to the app. Set PathBase when
# the app is served from a sub-path, e.g. https://intra.example.com/calendar.
#ReverseProxy__PathBase=/calendar
#ReverseProxy__TrustForwardedHeaders=true
# Restrict which peers may send X-Forwarded-* headers. Leave unset to accept them from
# any peer, which is fine when the app is only reachable through the proxy.
#ReverseProxy__KnownProxies__0=10.0.0.7
#ReverseProxy__KnownNetworks__0=10.0.0.0/8

# ---- Absence webhook ----
# POSTs absence.created / absence.updated / absence.deleted to a URL of your choosing.
# Set a secret: it signs the body so the receiver can tell real events from anyone who
# has learned the URL. See the README for the payload and delivery guarantees.
#Webhook__Url=https://hooks.example.internal/foo-calendar
#Webhook__Secret=
# Absence notes are never sent, and there is no setting that sends them: a note is free
# text, and a hook usually ends up somewhere far wider than the people it was written for.
# The `note` and `reviewNote` fields stay in the payload and always arrive null.

# ---- Email notifications ----
# Opt-in email for three things: your own absence request being approved/rejected, a new
# request waiting for you to review (if you hold AbsencesApprove), and a weekly "who's off
# this week" digest. Nobody gets anything until they turn a toggle on in their own profile;
# this section only says whether the app is *able* to send mail at all.
#
# Email__Host empty (the default) disables sending entirely, and with it the weekly-digest
# scheduler, the same way an empty Webhook__Url disables webhook delivery.
#Email__Host=smtp.example.com
#Email__Port=587
#Email__UseStartTls=true
#Email__Username=
#Email__Password=
#Email__FromAddress=noreply@example.com
#Email__FromName=Foo Calendar
# Lets an email link back into the app. Left blank, emails describe what happened without
# a link.
#Email__AppUrl=https://intra.example.com/calendar
#
# When the weekly digest goes out, checked against the server process's own local clock -
# this app has no other notion of a deployment's timezone, so set your container's TZ if
# you care which local time "07:00" means.
#Email__WeeklyDigest__Enabled=true
#Email__WeeklyDigest__DayOfWeek=Monday
#Email__WeeklyDigest__TimeOfDay=07:00:00

# ---- API reference ----
# Serves the OpenAPI document at /openapi/v1.json and the Scalar reference UI at /scalar.
# Both are anonymous, since a browser opening them carries no token, so this publishes the
# shape of the API - paths, parameters, schemas, never data - to anyone who can reach the
# app. Development turns it on for you; everywhere else it stays off until you set it here.
#ApiDocs__Enabled=true
#ApiDocs__RoutePrefix=/scalar

# ---- Observability ----
# Nothing is exported until an endpoint is set. See the README's Observability section.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#OTEL_SERVICE_NAME=foo-calendar

# ---- Host port ----
# Read by compose itself rather than the app; the container always listens on 8080.
#FOO_CALENDAR_PORT=8080

# ---- Trying it out ----
# Uncomment to run without an identity provider at all: SSO is bypassed and you are signed
# in as Auth:DevUser, holding every permission. The Auth__* values above are then ignored.
# The API refuses this outside Development, so it cannot be deployed by accident.
#ASPNETCORE_ENVIRONMENT=Development
