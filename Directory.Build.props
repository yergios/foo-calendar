<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Product>Foo Calendar</Product>
    <Copyright>Copyright (c) 2026 Sergio Y. Lee</Copyright>

    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Every analyzer rule is on (AnalysisMode=All) and every warning fails the build, so a
         new warning is fixed, or suppressed with its reason in .editorconfig, on the commit
         that introduces it. NuGet audit findings (NU190x) fail it too: a published advisory
         against a dependency is a build break until it is upgraded or pinned past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>

